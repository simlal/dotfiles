{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "permission": {
    "read": "allow",
    "edit": "ask",
    "glob": "allow",
    "grep": "allow",
    "webfetch": "allow",
    "task": "ask",
    "question": "allow",
    "bash": {
      "*": "ask",
      "git *": "allow",
      "git status *": "allow",
      "git status": "allow",
      "git log *": "allow",
      "git diff *": "allow",
      "git show *": "allow",
      "git branch *": "allow",
      "git remote *": "allow",
      "git config --get *": "allow",
      "git blame *": "allow",
      "git stash list *": "allow",
      "git commit *": "ask",
      "git push *": "ask",
      "git pull *": "ask",
      "git reset *": "ask",
      "git revert *": "ask",
      "git clean *": "ask",
      "git checkout *": "ask",
      "git merge *": "ask",
      "git rebase *": "ask",
      "gh *": "ask",
      "gh pr view *": "allow",
      "gh pr view": "allow",
      "gh pr list *": "allow",
      "gh pr list": "allow",
      "gh pr checks *": "allow",
      "gh pr diff *": "allow",
      "gh pr status *": "allow",
      "gh pr status": "allow",
      "gh issue view *": "allow",
      "gh issue list *": "allow",
      "gh issue list": "allow",
      "gh issue status *": "allow",
      "gh repo view *": "allow",
      "gh repo list *": "allow",
      "gh run list *": "allow",
      "gh run view *": "allow",
      "gh search *": "allow",
      "gh auth status": "allow",
      "rg *": "allow",
      "fd *": "allow",
      "find *": "allow",
      "ls *": "allow",
      "ls": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "file *": "allow",
      "stat *": "allow",
      "tree *": "allow",
      "pwd": "allow",
      "date *": "allow",
      "uname *": "allow",
      "whoami": "allow",
      "which *": "allow",
      "type *": "allow",
      "echo *": "allow",
      "docker ps *": "allow",
      "docker images *": "allow",
      "docker inspect *": "allow",
      "docker logs *": "allow",
      "docker version": "allow",
      "docker info": "allow",
      "npm ls *": "allow",
      "npm list *": "allow",
      "npm view *": "allow",
      "npm info *": "allow",
      "curl *": "allow",
      "wget *": "allow",
      "grep *": "allow",
      "sort *": "allow",
      "uniq *": "allow",
      "cut *": "allow",
      "tr *": "allow",
      "jq *": "allow",
      "column *": "allow",
      "rev *": "allow",
      "nl *": "allow",
      "tac *": "allow"
    }
  },
  "mcp": {
    "servers": {
      "atlassian": {
        "type": "remote",
        "url": "https://mcp.atlassian.com/v2/mcp",
        "disabled": false
      }
    }
  },
  "tools": {
    "atlassian*": false
  },
  "agent": {
    "build": {
      "model": "opencode-go/deepseek-v4.1-flash",
      "tools": {
        "atlassian*": true
      },
      "permission": {
        "atlassian_*": "ask",
        "atlassian_get*": "allow",
        "atlassian_search*": "allow",
        "atlassian*delete*": "deny"
      }
    },
    "plan": {
      "model": "opencode-go/deepseek-v4-pro",
      "tools": {
        "atlassian*": true
      },
      "permission": {
        "atlassian_*": "ask",
        "atlassian_get*": "allow",
        "atlassian_search*": "allow",
        "atlassian*delete*": "deny"
      }
    },
    "general": {
      "permission": {
        "atlassian_*": "deny"
      }
    },
    "explore": {
      "permission": {
        "atlassian_*": "deny"
      }
    }
  },
  "disabled_providers": ["amazon-bedrock"],
  "provider": {
    // local model example
    "llama.cpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama-server (local)",
      "options": {
        "baseURL": "http://localhost:8081/v1"
      },
      "models": {
        "qwen2.5-coder-14b": {
          "name": "Qwen 2.5 Coder 14B (local)",
          "limit": {
            "context": 32768,
            "output": 4096
          }
        }
      }
    }
  }
}
